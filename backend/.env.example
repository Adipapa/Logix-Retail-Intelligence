APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://logix:change-this-db-password@db:5432/logix_retail
POSTGRES_PASSWORD=change-this-db-password
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
BOOTSTRAP_ADMIN_EMAIL=admin@logixretail.gm
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-first-run
BOOTSTRAP_ADMIN_NAME=Logix Central Administrator

# Dropbox scoped app: files.metadata.read and files.content.read
# Use OAuth refresh-token flow for production; never commit real credentials.
DROPBOX_ACCESS_TOKEN=
DROPBOX_REFRESH_TOKEN=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_ROOT_PATH=/Logix Retail
