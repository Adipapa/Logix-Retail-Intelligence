# Copy to backend/.env. Never commit real secrets.
APP_ENV=development
APP_NAME=Logix Retail Intelligence API
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=postgresql+psycopg://logix:change-this-db-password@localhost:5432/logix_retail
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
BOOTSTRAP_ADMIN_EMAIL=admin@logixretail.gm
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-first-run
BOOTSTRAP_ADMIN_NAME=System Administrator
